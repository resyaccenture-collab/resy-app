# ── Email credentials ──────────────────────────────────────────────────────────
# Gmail: enable 2-Step Verification, then go to myaccount.google.com/apppasswords
# and create an App Password for "Mail". Paste it as EMAIL_PASS below.
#
# Any other SMTP: set SMTP_HOST / SMTP_PORT and provide credentials.

EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Optional overrides (defaults to Gmail SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

PORT=3000
